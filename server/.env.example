# DisasterNav Server Environment Variables
PORT=3001

# NASA FIRMS API Key (Optional - free at https://firms.modaps.eosdis.nasa.gov/api/area/)
# Leave empty or default to use built-in curated realistic feed
FIRMS_API_KEY=

# OpenRouteService API Key (Optional - free at https://openrouteservice.org/dev/#/signup)
# When empty, seamlessly falls back to free OSRM with automatic hazard avoidance detours
ORS_API_KEY=
